<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/SettingsMenuStyle.uss?fileID=7433441132597879392&amp;guid=fcfd70443f4ea4c48a666c69d4d08bb2&amp;type=3#SettingsMenuStyle" />
    <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/packages/DontUseAnymore/Fantasy%20Skybox%20FREE/Cubemaps/FS003/Images/FS003_Sunset_Cubemap_right.png?fileID=2800000&amp;guid=d533b63a73a0593468356a0aae73b209&amp;type=3#FS003_Sunset_Cubemap_right&quot;);">
        <ui:Label text="Settings" name="TitleLabel" style="flex-shrink: 0; flex-grow: 0; align-items: center; justify-content: center; align-self: auto; align-content: center; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 60px; color: rgb(185, 0, 0); text-shadow: 1px 1px 0 rgb(128, 0, 0); letter-spacing: 0;">
            <ui:Button text="Main Menu" name="BackButton" class="button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
        </ui:Label>
        <ui:DropdownField label="Difficulty" name="DifficultyDropdown" choices="Easy,Medium,Hard" focusable="false" style="left: auto; position: relative; flex-direction: row; align-items: auto; width: 461px; font-size: 40px; top: auto; justify-content: flex-start; align-self: center; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgba(255, 255, 255, 0); -unity-font-style: bold; -unity-text-align: middle-center;" />
    </ui:VisualElement>
</ui:UXML>
